# Copy to .dev.vars for local development (never commit .dev.vars).

# Optional: the setup key and the key that encrypts Settings → Sign-in (32+ characters; make one with
# `openssl rand -base64 32`). With it, the sign-in settings below can be changed in the app instead, and an empty
# database shows the "set up this instance" page. Without it, everything here is used as it is.
TOKEN_KEY=

# Google OAuth client (Web application). Authorized redirect URI: http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: sign-in with codes sent by email, through Resend (or set it up in Settings → Sign-in, with a TOKEN_KEY).
# EMAIL_CODES=on
# RESEND_API_KEY=
# MAIL_FROM=tasks@yourdomain.com

# Optional: "Continue with email" sign-in through WorkOS AuthKit (use the Staging environment's values).
# Redirect URI to add in WorkOS: http://localhost:5173/auth/workos/callback
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Optional: "Continue with Microsoft" sign-in through your organization's Entra ID tenant (see the README).
# Redirect URI to add to the app registration: http://localhost:5173/auth/microsoft/callback
# MS_TENANT_ID is the tenant's ID (a GUID) or one of its domains, never "common".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Optional: attach files from Google Drive (see the README). Needs GOOGLE_CLIENT_ID, with http://localhost:5173 as an
# Authorized JavaScript origin on it. The API key is the Picker's; the app id is the Cloud project's number.
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=

# Optional: attach files from OneDrive / SharePoint (see the README). Needs MS_CLIENT_ID and MS_TENANT_ID, and the SPA
# redirect URI http://localhost:5173/picker-signin.html on the app registration.
MS_FILES=

# Optional: notifications (Web Push). Make a pair for local use with:  npm run -s push-keys >> .dev.vars
# (Deployed instances get their own automatically on the first `npm run deploy`.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional, comma-separated: addresses always let in as admins. (Without a TOKEN_KEY, the first person to sign in to an
# empty database becomes the admin anyway.)
ADMIN_EMAILS=

# Local only: enables /auth/dev-login?email=... so you can sign in as seeded users without Google.
# Ignored unless the request comes from localhost. Never set this in production.
DEV_LOGIN=1
